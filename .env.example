# ============================================================
# Adwyzors ERP — Environment Variables Template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any file with real credentials.
# ============================================================

# ----------------------------
# Database (PostgreSQL)
# ----------------------------
DATABASE_URL="postgresql://adwyzors:localdevpassword@localhost:5432/adwyzors_dev"

# ----------------------------
# Redis
# ----------------------------
REDIS_URL="redis://:localdevpassword@localhost:6379"

# ----------------------------
# Auth.js v5
# Generate secret: openssl rand -hex 32
# ----------------------------
AUTH_SECRET="replace-with-openssl-rand-hex-32-output"
AUTH_URL="http://localhost:3000"

# ----------------------------
# Cloudflare R2 (File Storage)
# Leave empty to use local disk storage in development
# ----------------------------
STORAGE_PROVIDER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ----------------------------
# Application
# ----------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# ----------------------------
# Observability (Optional in dev)
# ----------------------------
# SENTRY_DSN=""
# LOG_LEVEL="debug"
