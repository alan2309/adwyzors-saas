// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANT
// The root entity for multi-tenancy.
// Every other model (except Permission) is scoped to a Tenant.
// ============================================================
model Tenant {
  id           String    @id @default(cuid())
  name         String
  subdomain    String    @unique
  customDomain String?   @unique
  plan         String    @default("trial")
  configJson   Json      @default("{}")
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  version      Int       @default(1)

  // Relations
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]
  passwordResetTokens PasswordResetToken[]
  notifications Notification[]
  customers Customer[]
  products  Product[]
  warehouses Warehouse[]
  vendors   Vendor[]

  @@index([subdomain])
  @@index([customDomain])
  @@index([status])
  @@map("tenants")
}

// ============================================================
// USER
// Belongs to exactly one tenant. Auth is done against this model.
// ============================================================
model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String?
  name         String
  avatarUrl    String?
  status       String    @default("active")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  version      Int       @default(1)

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  userRoles UserRole[]
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@map("users")
}

// ============================================================
// PERMISSION
// Global, platform-level permissions.
// Not tenant-scoped — defined once, assigned to roles.
// Key format: module.resource.action (e.g. "sales.order.create")
// ============================================================
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "sales.order.create"
  module      String // e.g. "sales"
  resource    String // e.g. "order"
  action      String // e.g. "create"
  description String
  createdAt   DateTime @default(now())

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

// ============================================================
// ROLE
// Tenant-scoped (tenantId NOT NULL for tenant roles).
// Platform roles (SUPER_ADMIN) have tenantId = NULL, isSystem = true.
// ============================================================
model Role {
  id          String    @id @default(cuid())
  tenantId    String? // NULL = platform role (SUPER_ADMIN, SYSTEM)
  name        String
  description String?
  isSystem    Boolean   @default(false)
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  version     Int       @default(1)

  // Relations
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("roles")
}

// ============================================================
// ROLE_PERMISSION (Junction)
// Normalized many-to-many between Role and Permission.
// Replaces the anti-pattern of storing permissions as JSON on Role.
// ============================================================
model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())
  assignedBy   String?

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// USER_ROLE (Junction)
// Assigns roles to users. A user may have multiple roles.
// ============================================================
model UserRole {
  userId     String
  roleId     String
  tenantId   String
  assignedAt DateTime @default(now())
  assignedBy String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@index([userId])
  @@map("user_roles")
}

// ============================================================
// AUDIT_LOG
// Immutable record of every data mutation in the system.
// Written by the Audit Engine on every create/update/delete.
// NEVER updated or deleted.
// ============================================================
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String // e.g. "user.created", "sales_order.approved"
  entityType String // e.g. "User", "SalesOrder"
  entityId   String
  before     Json? // State before mutation
  after      Json? // State after mutation
  ipAddress  String?
  userAgent  String?
  metadata   Json? // Additional context
  createdAt  DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// PASSWORD_RESET_TOKEN
// One-time-use tokens for the password recovery flow.
// Tokens expire after a set duration and can only be used once.
// ============================================================
model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// NOTIFICATION
// In-app notifications for users. Tenant-scoped.
// Supports read/unread state and optional deep links.
// ============================================================
model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  type      String    // e.g. "user.invited", "invoice.overdue", "system.announcement"
  title     String
  body      String?
  link      String?   // Deep link within the app (e.g. "/invoices/inv-123")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId])
  @@index([tenantId, userId, isRead])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

// ============================================================
// CUSTOMER
// CRM entity — represents a business customer or individual.
// Tenant-scoped. Supports both B2B and B2C.
// ============================================================
model Customer {
  id           String    @id @default(cuid())
  tenantId     String
  code         String    // Auto-generated: e.g. "MAHA-C-001"
  name         String
  type         String    @default("business") // "individual" | "business"
  email        String?
  phone        String?
  address      Json?     // { line1, line2, city, state, postalCode, country }
  gstin        String?   // India GST identification number
  pan          String?   // India PAN number
  creditLimit  Decimal?
  paymentTerms Int?      // days
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  version      Int       @default(1)

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  contacts Contact[]
  salesOrders SalesOrder[]
  invoices    Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("customers")
}

// ============================================================
// CONTACT
// Contact person associated with a Customer.
// A customer can have multiple contacts. One can be primary.
// ============================================================
model Contact {
  id         String  @id @default(cuid())
  tenantId   String
  customerId String
  name       String
  email      String?
  phone      String?
  role       String? // e.g. "Purchasing Manager", "Accounts"
  isPrimary  Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("contacts")
}

// ============================================================
// PRODUCT
// Inventory item — raw material, component, or finished good.
// Tenant-scoped. Unique code per tenant.
// ============================================================
model Product {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  categoryId  String?
  unit        String    // "pcs", "meters", "kg", "liters"
  hsn         String?   // Harmonised System Nomenclature code
  costPrice   Decimal?
  sellPrice   Decimal?
  taxRate     Decimal?
  minStock    Decimal?
  maxStock    Decimal?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  version     Int       @default(1)

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  stockMovements StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  salesOrderItems    SalesOrderItem[]
  boms               BillOfMaterials[]
  bomComponents      BOMItem[]          @relation("BOMComponent")
  productionOrders   ProductionOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("products")
}

// ============================================================
// WAREHOUSE
// Physical storage location. Tenant-scoped.
// ============================================================
model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  stockMovements StockMovement[]
  goodsReceipts  GoodsReceipt[]
  productionOrders ProductionOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

// ============================================================
// STOCK_MOVEMENT
// Immutable ledger entry for inventory changes.
// Current stock = SUM(quantity) WHERE type=inward - SUM(quantity) WHERE type=outward
// NEVER updated or deleted.
// ============================================================
model StockMovement {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  type        String   // "inward" | "outward" | "transfer" | "adjustment"
  quantity    Decimal
  unit        String
  reference   String?  // PO number, SO number, adjustment reason
  referenceId String?  // Foreign key to source document
  reason      String?
  createdAt   DateTime @default(now())
  createdBy   String?

  // Relations
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, productId, warehouseId])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

// ============================================================
// VENDOR
// Supplier entity for purchases. Tenant-scoped.
// ============================================================
model Vendor {
  id           String    @id @default(cuid())
  tenantId     String
  code         String
  name         String
  email        String?
  phone        String?
  gstin        String?
  address      Json?
  paymentTerms Int?
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  version      Int       @default(1)

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("vendors")
}

// ============================================================
// PURCHASE_ORDER
// Document for ordering goods from a vendor.
// ============================================================
model PurchaseOrder {
  id           String    @id @default(cuid())
  tenantId     String
  poNumber     String
  vendorId     String
  status       String    @default("draft") // draft | sent | confirmed | received | cancelled
  orderDate    DateTime
  expectedDate DateTime?
  totalAmount  Decimal   @default(0)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  version      Int       @default(1)

  // Relations
  vendor   Vendor              @relation(fields: [vendorId], references: [id])
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, vendorId])
  @@map("purchase_orders")
}

// ============================================================
// PURCHASE_ORDER_ITEM
// Line item on a purchase order.
// ============================================================
model PurchaseOrderItem {
  id        String  @id @default(cuid())
  poId      String
  productId String
  quantity  Decimal
  unit      String
  unitPrice Decimal
  taxRate   Decimal @default(0)
  total     Decimal

  // Relations
  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@map("purchase_order_items")
}

// ============================================================
// GOODS_RECEIPT
// Records receipt of goods against a PO. Triggers inward StockMovement.
// ============================================================
model GoodsReceipt {
  id          String   @id @default(cuid())
  tenantId    String
  poId        String
  warehouseId String
  receivedAt  DateTime @default(now())
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  // Relations
  po        PurchaseOrder      @relation(fields: [poId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  items     GoodsReceiptItem[]

  @@index([tenantId])
  @@index([poId])
  @@map("goods_receipts")
}

// ============================================================
// GOODS_RECEIPT_ITEM
// Line item on a goods receipt.
// ============================================================
model GoodsReceiptItem {
  id        String  @id @default(cuid())
  receiptId String
  productId String
  quantity  Decimal
  unit      String

  // Relations
  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@map("goods_receipt_items")
}

// ============================================================
// SALES_ORDER
// Customer order document.
// ============================================================
model SalesOrder {
  id           String    @id @default(cuid())
  tenantId     String
  orderNumber  String
  customerId   String
  status       String    @default("draft") // draft | confirmed | shipped | delivered | cancelled
  orderDate    DateTime
  deliveryDate DateTime?
  totalAmount  Decimal   @default(0)
  discount     Decimal   @default(0)
  taxAmount    Decimal   @default(0)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  version      Int       @default(1)

  // Relations
  customer Customer         @relation(fields: [customerId], references: [id])
  items    SalesOrderItem[]
  invoices Invoice[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("sales_orders")
}

// ============================================================
// SALES_ORDER_ITEM
// Line item on a sales order.
// ============================================================
model SalesOrderItem {
  id        String  @id @default(cuid())
  soId      String
  productId String
  quantity  Decimal
  unit      String
  unitPrice Decimal
  discount  Decimal @default(0)
  taxRate   Decimal @default(0)
  total     Decimal

  // Relations
  so      SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@index([soId])
  @@map("sales_order_items")
}

// ============================================================
// INVOICE
// Billing document linked to a sales order.
// ============================================================
model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  invoiceNumber String
  soId          String?
  customerId    String
  status        String    @default("draft") // draft | sent | paid | overdue | cancelled
  invoiceDate   DateTime
  dueDate       DateTime
  totalAmount   Decimal   @default(0)
  paidAmount    Decimal   @default(0)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  version       Int       @default(1)

  // Relations
  salesOrder SalesOrder? @relation(fields: [soId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  payments   Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("invoices")
}

// ============================================================
// PAYMENT
// Payment received against an invoice.
// ============================================================
model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  amount      Decimal
  method      String   // cash | bank_transfer | cheque | upi | card
  reference   String?  // Transaction ID, cheque number
  paidAt      DateTime
  notes       String?
  createdAt   DateTime @default(now())
  createdBy   String?

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

// ============================================================
// BILL_OF_MATERIALS (BOM)
// Recipe for a finished product — lists raw materials/components.
// ============================================================
model BillOfMaterials {
  id        String   @id @default(cuid())
  tenantId  String
  productId String   // Finished good
  version   Int      @default(1)
  status    String   @default("active") // active | draft | obsolete
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relations
  product Product   @relation(fields: [productId], references: [id])
  items   BOMItem[]
  productionOrders ProductionOrder[]

  @@unique([tenantId, productId, version])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@map("bill_of_materials")
}

// ============================================================
// BOM_ITEM
// Raw material/component entry in a BOM.
// ============================================================
model BOMItem {
  id        String  @id @default(cuid())
  bomId     String
  productId String  // Raw material / component
  quantity  Decimal
  unit      String
  scrap     Decimal @default(0) // Scrap percentage (e.g. 5 = 5%)

  // Relations
  bom     BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product         @relation("BOMComponent", fields: [productId], references: [id])

  @@index([bomId])
  @@map("bom_items")
}

// ============================================================
// PRODUCTION_ORDER
// Manufacturing work order — consumes raw materials, produces finished goods.
// On start: outward StockMovement for raw materials.
// On complete: inward StockMovement for finished product.
// ============================================================
model ProductionOrder {
  id           String    @id @default(cuid())
  tenantId     String
  orderNumber  String
  productId    String    // Finished product to produce
  bomId        String
  warehouseId  String    // Warehouse for material consumption and output
  quantity     Decimal   // Quantity to produce
  status       String    @default("planned") // planned | in_progress | completed | cancelled
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?

  // Relations
  product   Product         @relation(fields: [productId], references: [id])
  bom       BillOfMaterials @relation(fields: [bomId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("production_orders")
}

// ============================================================
// ACCOUNT (Chart of Accounts)
// Double-entry accounting ledger accounts. Tenant-scoped.
// Types: asset, liability, equity, revenue, expense
// ============================================================
model Account {
  id          String   @id @default(cuid())
  tenantId    String
  code        String   // e.g. "1001", "3001"
  name        String
  type        String   // asset | liability | equity | revenue | expense
  parentId    String?  // For hierarchical chart of accounts
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  // Relations
  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, type])
  @@map("accounts")
}

// ============================================================
// JOURNAL_ENTRY
// A complete accounting transaction. Contains debit/credit lines.
// Total debits MUST equal total credits (enforced at API level).
// ============================================================
model JournalEntry {
  id          String   @id @default(cuid())
  tenantId    String
  entryNumber String
  date        DateTime
  description String
  reference   String?  // Invoice number, PO number, etc.
  referenceId String?
  status      String   @default("posted") // posted | draft | reversed
  createdAt   DateTime @default(now())
  createdBy   String?

  // Relations
  lines JournalLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@map("journal_entries")
}

// ============================================================
// JOURNAL_LINE
// Single debit or credit entry within a journal entry.
// ============================================================
model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  debit     Decimal @default(0)
  credit    Decimal @default(0)
  narration String?

  // Relations
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

// ============================================================
// TAX_CONFIG
// Tax rate configurations (GST slabs for India). Tenant-scoped.
// ============================================================
model TaxConfig {
  id       String  @id @default(cuid())
  tenantId String
  name     String  // e.g. "GST 18%", "GST 5%", "Exempt"
  rate     Decimal // e.g. 18, 5, 0
  type     String  // gst | cess | custom
  isActive Boolean @default(true)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tax_configs")
}

// ============================================================
// NUMBER_SEQUENCE
// Configurable auto-numbering patterns per entity type.
// e.g. PO prefix "PO-", SO prefix "SO-", padding 4 = PO-0001
// ============================================================
model NumberSequence {
  id         String @id @default(cuid())
  tenantId   String
  entityType String // "purchase_order" | "sales_order" | "invoice" | "customer" | "product" | "production_order"
  prefix     String // e.g. "PO-", "INV-"
  padding    Int    @default(4)
  nextValue  Int    @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, entityType])
  @@index([tenantId])
  @@map("number_sequences")
}

// ============================================================
// AUTOMATION_RULE
// Event-driven automation configuration per tenant.
// e.g. trigger: "sales_order.created", condition: { totalAmount > 100000 }, action: "notify.email"
// ============================================================
model AutomationRule {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  trigger   String   // Domain event: "sales_order.created", "invoice.overdue", etc.
  condition Json     @default("{}") // { field, operator, value }
  action    String   // "notify.email" | "notify.inapp" | "update.status" | "webhook"
  config    Json     @default("{}") // Action-specific config (template, recipients, url)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([tenantId])
  @@index([tenantId, trigger])
  @@index([tenantId, isActive])
  @@map("automation_rules")
}

// ============================================================
// REPORT_TEMPLATE
// Configurable report definitions stored per tenant.
// Used by the export worker to generate scheduled or on-demand reports.
// ============================================================
model ReportTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  entityType  String   // "customers" | "products" | "sales_orders" | "invoices" | etc.
  columns     Json     // Array of column definitions
  filters     Json     @default("{}") // Default filters
  schedule    String?  // Cron expression for scheduled reports (null = on-demand)
  format      String   @default("csv") // "csv" | "xlsx" | "pdf"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  @@index([tenantId])
  @@map("report_templates")
}
